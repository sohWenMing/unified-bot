# Bot Meta-Repository Environment Configuration
# =============================================
# Copy this file to .env and fill in your actual values.
# NEVER paste API keys or passwords in chat - always edit this file directly!

# ===========================================
# LLM Configuration (for markitdown & artifacts)
# ===========================================
# Get your API key from: https://aistudio.google.com/apikey
API_KEY=your_api_key_here

# API endpoint URL (default is Google Gemini)
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model to use for document processing
# Options: gemini-2.0-flash (fast), gemini-1.5-pro (higher quality)
LLM_MODEL=gemini-2.0-flash

# ===========================================
# Playwright Test Configuration
# ===========================================
# URL of the application you want to test
APP_URL=https://your-app.com

# Test user credentials (for automated login tests)
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=your_secure_password_here

# Additional test credentials (optional)
# TEST_ADMIN_EMAIL=admin@example.com
# TEST_ADMIN_PASSWORD=

# ===========================================
# Notes
# ===========================================
# - This file is git-ignored for security
# - Never share this file or commit it to version control
# - Regenerate API keys if accidentally exposed
